#!/bin/sh
# NASsurfer: Dienst starten/stoppen. Der Dienst startet Chromium erst,
# wenn jemand das Fenster öffnet, und beendet ihn nach 15 Minuten Leerlauf.
PKG=NASsurfer
TARGET="${SYNOPKG_PKGDEST:-/var/packages/$PKG/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG/var}"
PID="$VAR/daemon.pid"
LOG="$VAR/daemon.log"
FLAG="$VAR/running"

is_running() {
    [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null
}

case "$1" in
    start)
        is_running && { : > "$FLAG"; exit 0; }
        if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 1048576 ]; then
            mv -f "$LOG" "$LOG.1"
        fi
        "$TARGET/bin/nassurfer" daemon >> "$LOG" 2>&1 &
        echo $! > "$PID"
        sleep 1
        is_running || exit 1
        : > "$FLAG"
        exit 0
        ;;
    stop)
        rm -f "$FLAG"
        if is_running; then
            kill "$(cat "$PID")"
            i=0
            while is_running && [ "$i" -lt 10 ]; do
                sleep 1
                i=$((i + 1))
            done
            is_running && kill -9 "$(cat "$PID")"
        fi
        rm -f "$PID"
        rm -rf "$VAR/sessions"
        STATE="/tmp/nassurfer-$(id -u)"
        [ -d "$STATE" ] && [ ! -L "$STATE" ] && rm -rf "$STATE"
        exit 0
        ;;
    status)
        is_running && exit 0
        exit 3
        ;;
    log)
        echo "$LOG"
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
